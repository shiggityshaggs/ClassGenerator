<Window x:Class="ClassGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassGenerator"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="JsonTree" SelectedItemChanged="JsonTree_SelectedItemChanged" />

        <StackPanel Grid.Column="1" Margin="10">
            <Button Content="Load JSON" Click="LoadJson_Click" Margin="10" />
            <TextBlock Text="Selected Node:" FontWeight="Bold" />
            <TextBlock x:Name="NodePath" />
            <TextBlock Text="Inferred Type:" />
            <TextBox x:Name="InferredTypeBox" IsReadOnly="True" />
            <TextBlock Text="Override Type:" />
            <TextBox x:Name="OverrideTypeBox" />
            <CheckBox x:Name="IsDictionaryBox" Content="Treat as Dictionary string, T" />
            <Button Content="Apply" Click="ApplyOverride_Click" Margin="0,10,0,0" />
            <TextBlock Text="Generated Class Preview:" FontWeight="Bold" Margin="0,20,0,0" />
            <TextBox x:Name="ClassPreviewBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="300" />
        </StackPanel>
    </Grid>
</Window>
